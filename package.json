{
  "name": "srclawyer",
  "version": "0.1.0",
  "description": "Static analysis engine that derives privacy policy documentation directly from source code",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "bin": {
    "srclawyer": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:corpus": "tsx scripts/scoreCorpus.ts",
    "test:corpus:update-baseline": "tsx scripts/scoreCorpus.ts --update-baseline",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^7.25.6",
    "@babel/traverse": "^7.25.6",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "js-yaml": "^4.1.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^5.0.0"
  }
}
