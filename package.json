{
  "name": "srclawyer",
  "version": "0.4.1",
  "description": "Static analysis engine that derives privacy policy documentation directly from source code",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "srclawyer": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "postinstall.cjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "postinstall": "node postinstall.cjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:corpus": "tsx scripts/scoreCorpus.ts",
    "test:corpus:update-baseline": "tsx scripts/scoreCorpus.ts --update-baseline",
    "test:corpus:with-llm": "node --env-file=.env node_modules/.bin/tsx scripts/scoreCorpus.ts --with-llm",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^7.25.6",
    "@babel/traverse": "^7.25.6",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.2",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.4",
    "tsx": "^4.19.1",
    "vitest": "^5.0.0"
  }
}
